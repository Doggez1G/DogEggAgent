  "cards": [
    {
      "dot": "emerald",
      "title": "迁移立法",
      "items": [
        "主链迁移输入：submit → thought_done → tool_calls → final_answer",
        "15 种输入各有 VALID_FROM 白名单，非法组合原地不动；finished 后下一轮 submit 回 idle"
      ]
    },
    {
      "dot": "violet",
      "title": "工具循环",
      "items": [
        "tool_auto 直达执行；ask 或默认兜底挂起审批，四档决议（本次 / 始终 / 范围 / 拒绝）",
        "tool_done / result_back 后重新请求模型；拒绝与未知工具也发 tool_end（可见失败）"
      ]
    },
    {
      "dot": "amber",
      "title": "恢复语义",
      "items": [
        "cancel / error 对任意运行态生效；终态经 reset 或下一轮 submit 回 idle",
        "compact_done 自动回 thinking / responding（手动回 idle）；压缩产出 ≥ 原文视为未压缩"
      ]
    }
  ]
